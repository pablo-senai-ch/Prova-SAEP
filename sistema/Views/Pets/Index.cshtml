@model IEnumerable<ClinicaVeterinaria.Models.Pet>
<h1>Pets</h1>
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}
<a asp-action="Create" class="btn btn-success mb-3">Novo pet</a>
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Espécie</th>
                <th>Raça</th>
                <th>Nascimento</th>
                <th>Tutor</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pet in Model)
            {
                <tr>
                    <td>@pet.Nome</td>
                    <td>@pet.Especie</td>
                    <td>@(pet.Raca ?? "Não informada")</td>
                    <td>@(pet.DataNascimento?.ToString("dd/MM/yyyy") ?? "Não informado")</td>
                    <td>@pet.Tutor.Nome</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@pet.Id">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@pet.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
